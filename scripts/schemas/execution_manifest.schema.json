{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "iteration_id",
    "run_id",
    "code_sha",
    "env",
    "scope",
    "command",
    "expected_nodeids",
    "collected_nodeids",
    "environment_summary",
    "seed_summary",
    "target_summary",
    "attempts"
  ],
  "properties": {
    "schema_version": {"const": "1.1"},
    "iteration_id": {"type": "string", "pattern": "^[a-z0-9][a-z0-9-]{2,63}$"},
    "run_id": {"type": "string", "pattern": "^run-[0-9]{8}T[0-9]{6}Z(-[a-z0-9]{4})?$"},
    "code_sha": {"type": "string", "pattern": "^[a-f0-9]{40,64}$"},
    "env": {"type": "string", "enum": ["local", "test", "ci", "prod"]},
    "scope": {"type": "string", "enum": ["module_set", "failing_subset", "full"]},
    "command": {"type": "string", "minLength": 1},
    "expected_nodeids": {"$ref": "#/definitions/nodeids"},
    "collected_nodeids": {"$ref": "#/definitions/nodeids"},
    "environment_summary": {
      "type": "object",
      "additionalProperties": false,
      "required": ["name", "path", "sha256"],
      "properties": {
        "name": {"type": "string", "minLength": 1},
        "path": {"type": "string", "minLength": 1},
        "sha256": {"$ref": "#/definitions/sha256"}
      }
    },
    "seed_summary": {
      "type": "object",
      "additionalProperties": false,
      "required": ["path", "sha256"],
      "properties": {
        "path": {"type": "string", "minLength": 1},
        "sha256": {"$ref": "#/definitions/sha256"}
      }
    },
    "target_summary": {
      "type": "object",
      "additionalProperties": false,
      "required": ["config_sha256", "image_ids"],
      "properties": {
        "config_sha256": {"$ref": "#/definitions/sha256"},
        "image_ids": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {"type": "string", "pattern": "^(sha256:[a-f0-9]{64}|unavailable)$"}
        }
      }
    },
    "attempts": {
      "type": "array",
      "minItems": 1,
      "items": {"$ref": "#/definitions/attempt"}
    }
  },
  "definitions": {
    "sha256": {"type": "string", "pattern": "^[a-f0-9]{64}$"},
    "nodeid": {"type": "string", "pattern": "^automation/[^\\x00\\\\]+::[^\\x00\\\\]+$"},
    "nodeids": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {"$ref": "#/definitions/nodeid"}
    },
    "junit": {
      "type": "object",
      "additionalProperties": false,
      "required": ["path", "sha256", "tests", "failures", "errors", "skipped"],
      "properties": {
        "path": {"type": "string", "minLength": 1},
        "sha256": {"$ref": "#/definitions/sha256"},
        "tests": {"type": "integer", "minimum": 1},
        "failures": {"type": "integer", "minimum": 0},
        "errors": {"type": "integer", "minimum": 0},
        "skipped": {"type": "integer", "minimum": 0}
      }
    },
    "allure": {
      "type": "object",
      "additionalProperties": false,
      "required": ["path", "sha256", "available"],
      "properties": {
        "path": {"type": "string", "minLength": 1},
        "sha256": {"$ref": "#/definitions/sha256"},
        "available": {"type": "boolean"}
      }
    },
    "attempt": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "attempt_number",
        "result",
        "expected_nodeids",
        "collected_nodeids",
        "executed_nodeids",
        "outcomes",
        "junit",
        "allure"
      ],
      "properties": {
        "attempt_number": {"type": "integer", "minimum": 1},
        "result": {"enum": ["pass", "fail"]},
        "expected_nodeids": {"$ref": "#/definitions/nodeids"},
        "collected_nodeids": {"$ref": "#/definitions/nodeids"},
        "executed_nodeids": {"$ref": "#/definitions/nodeids"},
        "outcomes": {
          "type": "object",
          "additionalProperties": {"enum": ["passed", "failed", "skipped", "xfailed", "xpassed", "unknown"]}
        },
        "junit": {"$ref": "#/definitions/junit"},
        "allure": {"$ref": "#/definitions/allure"}
      }
    }
  }
}
