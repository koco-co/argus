{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "source_type",
    "service_name",
    "package",
    "captured_at",
    "authentication",
    "base_url",
    "routes",
    "observed_live_probe",
    "notes"
  ],
  "properties": {
    "schema_version": {"const": "1.0"},
    "source_type": {"const": "source_code_and_live_probe"},
    "service_name": {"type": "string", "minLength": 1},
    "package": {
      "type": "object",
      "additionalProperties": false,
      "required": ["name", "version", "repository", "commit", "container_path"],
      "properties": {
        "name": {"type": "string", "minLength": 1},
        "version": {"type": "string", "minLength": 1},
        "repository": {"type": "string", "format": "uri"},
        "commit": {"type": "string", "pattern": "^[0-9a-f]{40}$"},
        "container_path": {"type": "string", "minLength": 1}
      }
    },
    "captured_at": {"type": "string", "format": "date-time"},
    "authentication": {
      "type": "object",
      "additionalProperties": false,
      "required": ["header", "value"],
      "properties": {
        "header": {"type": "string", "minLength": 1},
        "value": {"type": "string", "minLength": 1}
      }
    },
    "base_url": {"type": "string", "format": "uri"},
    "routes": {
      "type": "array",
      "minItems": 1,
      "items": {"$ref": "#/definitions/route"}
    },
    "observed_live_probe": {"$ref": "#/definitions/live_probe"},
    "notes": {
      "type": "array",
      "minItems": 1,
      "items": {"type": "string", "minLength": 1}
    }
  },
  "definitions": {
    "string_array": {
      "type": "array",
      "items": {"type": "string", "minLength": 1}
    },
    "route_request": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "query": {"$ref": "#/definitions/string_array"},
        "path": {"$ref": "#/definitions/string_array"},
        "headers": {"$ref": "#/definitions/string_array"},
        "body": {"$ref": "#/definitions/string_array"}
      },
      "anyOf": [
        {"required": ["query"]},
        {"required": ["path"]},
        {"required": ["body"]},
        {"required": ["headers"]}
      ]
    },
    "route_response": {
      "type": "object",
      "additionalProperties": false,
      "required": ["success_status", "envelope"],
      "properties": {
        "success_status": {"type": "integer", "minimum": 200, "maximum": 299},
        "envelope": {"type": "string", "minLength": 1},
        "product_fields": {"$ref": "#/definitions/string_array"},
        "variant_fields": {"$ref": "#/definitions/string_array"},
        "cart_fields": {"$ref": "#/definitions/string_array"},
        "option_fields": {"$ref": "#/definitions/string_array"},
        "collection_fields": {"$ref": "#/definitions/string_array"},
        "session_fields": {"$ref": "#/definitions/string_array"},
        "order_fields": {"$ref": "#/definitions/string_array"},
        "order_item_fields": {"$ref": "#/definitions/string_array"},
        "order_shipping_fields": {"$ref": "#/definitions/string_array"},
        "order_payment_fields": {"$ref": "#/definitions/string_array"},
        "invalid_status": {"type": "integer", "minimum": 400, "maximum": 599},
        "invalid_envelope": {"$ref": "#/definitions/string_array"}
      },
      "allOf": [
        {
          "if": {"required": ["invalid_status"]},
          "then": {"required": ["invalid_envelope"]}
        },
        {
          "if": {"required": ["invalid_envelope"]},
          "then": {"required": ["invalid_status"]}
        }
      ]
    },
    "route": {
      "type": "object",
      "additionalProperties": false,
      "required": ["operation_id", "method", "path", "source_path", "request", "response"],
      "properties": {
        "operation_id": {"type": "string", "pattern": "^[A-Za-z][A-Za-z0-9_]*$"},
        "method": {"enum": ["GET", "POST", "PUT", "PATCH", "DELETE"]},
        "path": {"type": "string", "pattern": "^/"},
        "source_path": {"type": "string", "minLength": 1},
        "request": {"$ref": "#/definitions/route_request"},
        "response": {"$ref": "#/definitions/route_response"}
      }
    },
    "live_probe": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "probe_date",
        "product_selector",
        "variant_selector",
        "variant_title",
        "currency_code",
        "unit_amount",
        "promotion_code",
        "promotion_percentage",
        "invalid_promotion_status",
        "invalid_promotion_type",
        "missing_payment_provider_status",
        "missing_payment_provider_type",
        "shipping_selector",
        "payment_provider",
        "complete_type",
        "completed_order_variant_sku",
        "completed_order_payment_status"
      ],
      "properties": {
        "probe_date": {"type": "string", "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}$"},
        "product_selector": {"type": "string", "minLength": 1},
        "variant_selector": {"type": "string", "minLength": 1},
        "variant_title": {"type": "string", "minLength": 1},
        "currency_code": {"type": "string", "minLength": 1},
        "unit_amount": {"type": "number"},
        "promotion_code": {"type": "string", "minLength": 1},
        "promotion_percentage": {"type": "number", "minimum": 0, "maximum": 100},
        "invalid_promotion_status": {"type": "integer", "minimum": 400, "maximum": 599},
        "invalid_promotion_type": {"type": "string", "minLength": 1},
        "missing_payment_provider_status": {"type": "integer", "minimum": 400, "maximum": 499},
        "missing_payment_provider_type": {"type": "string", "minLength": 1},
        "shipping_selector": {"type": "string", "minLength": 1},
        "payment_provider": {"type": "string", "minLength": 1},
        "complete_type": {"type": "string", "minLength": 1},
        "completed_order_variant_sku": {"type": "string", "minLength": 1},
        "completed_order_payment_status": {"type": "string", "minLength": 1}
      }
    }
  }
}
